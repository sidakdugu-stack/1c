Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	// 1. Сначала записываем строки из документа в регистр расчета,
	// чтобы платформа 1С автоматически распределила периоды с учетом вытеснения
	Движения.Зарплата.Записывать = Истина;
	Движения.Зарплата.Очистить();
	
	Для Каждого ТекСтрока Из Начисления Цикл
		Движение = Движения.Зарплата.Добавить();
		Движение.Сотрудник = ТекСтрока.Сотрудник;
		Движение.ВидРасчета = ТекСтрока.ВидРасчета;
		Движение.ПериодРегистрации = ПериодРегистрации;
		Движение.ПериодДействияНачало = ТекСтрока.ДатаНачала;
		Движение.ПериодДействияКонец = ТекСтрока.ДатаОкончания;
		Движение.Размер = ТекСтрока.Размер;
	КонецЦикла;
	
	// Принудительно сохраняем движения конкретного регистра в базе данных
	Движения.Зарплата.Записать();
	
	// 2. Формируем запрос к виртуальной таблице"ДанныеГрафика"
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗарплатаДанныеГрафика.НомерСтроки КАК НомерСтроки,
		|	ЗарплатаДанныеГрафика.Размер КАК РазмерОклада,
		|	ЕСТЬNULL(ЗарплатаДанныеГрафика.ЗначениеПериодДействия, 0) КАК ВсегоДнейВМесяце,
		|	ЕСТЬNULL(ЗарплатаДанныеГрафика.ЗначениеФактическийПериодДействия, 0) КАК ФактическиОтработано
		|ИЗ
		|	РегистрРасчета.Зарплата.ДанныеГрафика(Регистратор =&Регистратор) КАК ЗарплатаДанныеГрафика";
		
	Запрос.УстановитьПараметр("Регистратор", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	// 3. Рассчитываем итоговую сумму в цикле и дописываем результат обратно в регистр
	Пока Выборка.Следующий() Цикл
		Движение = Движения.Зарплата[Выборка.НомерСтроки - 1];
		
		// Расчет денег производим только для Оклада
		Если Движение.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Оклад Тогда
			Если Выборка.ВсегоДнейВМесяце>0 Тогда
				// Формула: (Оклад / Норма дней) * Фактически отработанные дни
				Движение.Результат = (Выборка.РазмерОклада / Выборка.ВсегоДнейВМесяце) * Выборка.ФактическиОтработано;
			Иначе
				Движение.Результат = 0;
			КонецЕсли;
		Иначе
			Движение.Результат = 0;
		КонецЕсли;
	КонецЦикла;
	
	// Обязательно записываем рассчитанные суммы результатов в базу данных!
	Движения.Зарплата.Записать();
	
КонецПроцедуры
